# Airtable (obligatorio para guardar proyectos, sesiones y requerimientos)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Solo si quieres que `npm run setup:airtable` cree la base por ti en vez de
# usar una que ya creaste manualmente (ver README).
AIRTABLE_WORKSPACE_ID=

# Deepgram (opcional; sin esto la app graba audio pero no transcribe en vivo)
DEEPGRAM_API_KEY=
# Opcional: evita una llamada extra a la API de Deepgram para resolver el proyecto
DEEPGRAM_PROJECT_ID=
