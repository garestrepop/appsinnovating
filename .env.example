# Airtable (obligatorio para guardar proyectos, sesiones y requerimientos)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Solo si quieres que `npm run setup:airtable` cree la base por ti en vez de
# usar una que ya creaste manualmente (ver README).
AIRTABLE_WORKSPACE_ID=

# Deepgram (opcional; sin esto la app graba audio pero no transcribe en vivo)
DEEPGRAM_API_KEY=
# Opcional: evita una llamada extra a la API de Deepgram para resolver el proyecto
DEEPGRAM_PROJECT_ID=

# Google Drive (obligatorio para guardar fotos, documentos y audio; sin esto
# la subida de adjuntos falla y solo queda la opción de descargar localmente)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Se obtiene corriendo: npm run setup:google-drive
GOOGLE_REFRESH_TOKEN=
# Carpeta raíz en tu Drive donde se crearán las subcarpetas por proyecto/sesión
# (créala manualmente y copia su ID de la URL: drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
